# Database (a plain Neon/Postgres URL works; it is adapted for asyncpg automatically)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# AI provider: set GEMINI_API_KEY (free) or OPENAI_API_KEY. OpenAI is used if both are set.
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY=""

# Cloudinary (optional, only needed for media uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Authentication
SECRET_KEY="generate_a_secure_random_key_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment and CORS
ENVIRONMENT="production" # Use "development" for local dev
# One or more comma-separated frontend origins
FRONTEND_URL="http://localhost:3000"
