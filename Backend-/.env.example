# Database Configuration
DATABASE_URL="postgresql+asyncpg://user:password@host/dbname?ssl=require"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"

# Authentication Configuration
SECRET_KEY="generate_a_secure_random_key_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment and CORS
ENVIRONMENT="production" # Use "development" for local dev
FRONTEND_URL="http://localhost:3000" # Change to your production frontend URL (e.g. https://voxa.vercel.app)
